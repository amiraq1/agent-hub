{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents.amiraq.org/schema/agents-state.schema.json",
  "title": "Nabd Agents State Schema",
  "description": "Formal single-source-of-truth JSON Schema for Nabd Agents (amiraq1/agent-hub). Enforced identically by scripts/validate-state.js in CI.",
  "type": "object",
  "required": [
    "updated_at",
    "agents",
    "tasks"
  ],
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "description": "Strict ISO 8601 UTC or offset timestamp of root state update."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing integer revision for optimistic concurrency control."
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "description": "Array of registered Nabd agents. Must contain at least one registered agent.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "status",
          "last_seen"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
            "description": "Unique agent identifier (slug format)."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name of the agent."
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "Role and operational responsibility of the agent."
          },
          "status": {
            "type": "string",
            "enum": [
              "working",
              "waiting",
              "idle",
              "offline",
              "error",
              "done"
            ],
            "description": "Current lifecycle status of the agent."
          },
          "current_task": {
            "type": "string",
            "description": "Brief description of current task or waiting condition."
          },
          "last_seen": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
            "description": "Strict ISO 8601 timestamp of agent heartbeat."
          },
          "connection": {
            "type": "string",
            "description": "Communication channel or coordination medium."
          }
        },
        "additionalProperties": true
      }
    },
    "tasks": {
      "type": "array",
      "description": "Array of shared tasks across agents.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "owner",
          "status",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique task identifier."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Task summary title."
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "description": "Agent ID responsible for execution."
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "waiting_review",
              "blocked",
              "done",
              "cancelled"
            ],
            "description": "Task progress status."
          },
          "link": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https?://.+",
            "description": "External PR or artifact link. Must use safe http/https protocol if provided."
          },
          "created_by": {
            "type": "string",
            "description": "Agent ID that initialized the task."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
          },
          "handoff": {
            "type": "object",
            "description": "Optional verified handoff receipt documenting cross-agent work transfer.",
            "required": [
              "from",
              "to",
              "at",
              "status",
              "summary",
              "next_step"
            ],
            "properties": {
              "from": {
                "type": "string",
                "description": "Sender agent ID (must be registered in agents)."
              },
              "to": {
                "type": "string",
                "description": "Recipient agent ID with next step (must be registered in agents)."
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "accepted",
                  "returned"
                ],
                "description": "Handoff lifecycle status."
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "description": "Concise summary of completed work."
              },
              "next_step": {
                "type": "string",
                "minLength": 1,
                "description": "Explicit next action required from recipient."
              },
              "evidence_url": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^https?://.+",
                "description": "Safe http/https URL pointing to evidence artifact or pull request."
              },
              "decision": {
                "type": "object",
                "description": "Decision object recorded when handoff is accepted or returned.",
                "required": [
                  "by",
                  "at"
                ],
                "properties": {
                  "by": {
                    "type": "string",
                    "description": "Agent ID making the decision (must be registered in agents)."
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
                  },
                  "reason": {
                    "type": "string",
                    "description": "Explanation of decision. Mandatory and non-empty when status is returned."
                  }
                },
                "additionalProperties": false
              },
              "history": {
                "type": "array",
                "description": "Optional chronological history of prior handoff receipts for this task.",
                "items": {
                  "type": "object",
                  "required": [
                    "status",
                    "at"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "accepted",
                        "returned"
                      ]
                    },
                    "at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
                    },
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "decision": {
                      "type": "object"
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "messages": {
      "type": "array",
      "description": "Chronological audit log of coordination messages exchanged between agents.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "at",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
